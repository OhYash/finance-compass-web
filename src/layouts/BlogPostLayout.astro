---
// BlogPostLayout.astro
import BaseLayout from './BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  ogImage?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  author = 'INR Finance Compass Team',
  ogImage,
  headings = [],
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const blogUrl = `${baseUrl}/blog`;

const formattedDate = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(pubDate);

const formattedUpdated = updatedDate
  ? new Intl.DateTimeFormat('en-IN', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }).format(updatedDate)
  : null;
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  type="article"
  publishedTime={pubDate.toISOString()}
  tags={tags}
>
  <!-- Reading Progress Bar -->
  <div
    id="reading-progress"
    class="fixed top-16 left-0 h-1 bg-emerald-500 z-40 w-0 transition-all duration-75 ease-out"
  ></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Back to Blog Link -->
    <div class="mb-8">
      <a
        href={blogUrl}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-500 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors group"
      >
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5m7 7-7-7 7-7"/>
        </svg>
        <span>Back to Blog & Guides</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4 pb-8 border-b border-zinc-200 dark:border-zinc-800">
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/40">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight leading-tight font-serif-editorial">
        {title}
      </h1>

      <p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-3xl">
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-4 text-xs text-zinc-500 dark:text-zinc-400 pt-2">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-full bg-emerald-600 flex items-center justify-center text-white text-[10px] font-bold">
            ₹
          </div>
          <span class="font-medium text-zinc-700 dark:text-zinc-300">{author}</span>
        </div>
        <span>&middot;</span>
        <time datetime={pubDate.toISOString()}>Published: {formattedDate}</time>
        {formattedUpdated && (
          <>
            <span>&middot;</span>
            <span>Updated: {formattedUpdated}</span>
          </>
        )}
      </div>
    </header>

    <!-- Table of Contents (if multiple headings) -->
    {headings.length > 2 && (
      <nav class="my-8 p-5 rounded-2xl bg-zinc-100/70 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
        <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3">
          Table of Contents
        </h4>
        <ul class="space-y-1.5 text-sm text-zinc-600 dark:text-zinc-400">
          {headings.filter(h => h.depth <= 3).map((heading) => (
            <li class={heading.depth === 3 ? 'ml-4' : ''}>
              <a href={`#${heading.slug}`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Article Content -->
    <article class="prose prose-zinc dark:prose-invert prose-emerald lg:prose-lg max-w-none pt-8">
      <slot />
    </article>

    <!-- Post Article CTA / Early Access Box -->
    <div class="mt-16 pt-10 border-t border-zinc-200 dark:border-zinc-800">
      <div class="rounded-2xl p-8 bg-gradient-to-br from-emerald-500/10 via-emerald-500/5 to-transparent dark:from-emerald-950/40 dark:via-zinc-900 dark:to-zinc-950 border border-emerald-500/20">
        <div class="max-w-xl space-y-3">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">
            <span>Sovereign Wealth &middot; INR Finance Compass</span>
          </div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">
            Take sovereign control of your Indian wealth.
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Stop giving fintech aggregators permission to harvest your credit card spends and bank accounts. Join the waitlist for INR Finance Compass — mathematically sound, self-hosted, and 100% private.
          </p>
          <div class="pt-2">
            <WaitlistForm variant="compact" id="blog-bottom-waitlist" source="blog-post" />
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupReadingProgress() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    window.addEventListener('scroll', () => {
      const totalScroll = document.documentElement.scrollHeight - window.innerHeight;
      if (totalScroll <= 0) return;
      const currentScroll = window.scrollY;
      const progress = Math.min(100, Math.max(0, (currentScroll / totalScroll) * 100));
      bar.style.width = `${progress}%`;
    }, { passive: true });
  }

  setupReadingProgress();
  document.addEventListener('astro:after-swap', setupReadingProgress);
</script>
