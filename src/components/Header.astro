---
// Header.astro
import ThemeToggle from './ThemeToggle.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = baseUrl || '/';
const blogUrl = `${baseUrl}/blog`;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/80 dark:bg-zinc-950/80 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={homeUrl} class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-500 flex items-center justify-center text-white shadow-sm shadow-emerald-500/20 group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" stroke-dasharray="38 12" opacity="0.45" />
          <path d="M8 18V6.5h4.2a4.5 4.5 0 0 1 4.5 4.5v0a4.5 4.5 0 0 1-4.5 4.5H8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M9.5 11.5l1.8-2 2 2.2 3.2-3.8" stroke="#a7f3d0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-zinc-900 dark:text-zinc-100 tracking-tight leading-none text-base">
          paise fit
        </span>
        <span class="text-[10px] uppercase font-mono tracking-wider text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
          Financial Fitness
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-zinc-600 dark:text-zinc-300">
      <!-- Features Dropdown Group -->
      <div class="relative group/dropdown py-4 flex items-center">
        <a
          href={`${homeUrl}#features`}
          class="flex items-center gap-1 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
        >
          <span>Features</span>
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200 group-hover/dropdown:rotate-180 text-zinc-400 group-hover/dropdown:text-emerald-600 dark:group-hover/dropdown:text-emerald-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Dropdown Menu -->
        <div
          class="absolute top-[calc(100%-8px)] left-0 w-48 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl shadow-zinc-900/5 dark:shadow-black/40 py-1.5 opacity-0 invisible translate-y-1 group-hover/dropdown:opacity-100 group-hover/dropdown:visible group-hover/dropdown:translate-y-0 group-focus-within/dropdown:opacity-100 group-focus-within/dropdown:visible group-focus-within/dropdown:translate-y-0 transition-all duration-150 z-50"
        >
          <a
            href={`${homeUrl}#features`}
            class="block px-3.5 py-2 text-xs font-medium text-zinc-700 dark:text-zinc-200 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
          >
            All Features
          </a>
          <a
            href={`${homeUrl}#goals`}
            class="block px-3.5 py-2 text-xs font-medium text-zinc-700 dark:text-zinc-200 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
          >
            Goal Planning
          </a>
          <a
            href={`${homeUrl}#deployments`}
            class="block px-3.5 py-2 text-xs font-medium text-zinc-700 dark:text-zinc-200 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
          >
            Deployments
          </a>
        </div>
      </div>

      <a href={blogUrl} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
        Blog & Guides
      </a>
      <a href={`${homeUrl}#faq`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
        FAQ
      </a>
    </nav>

    <!-- Right CTAs & Toggles -->
    <div class="flex items-center gap-3">
      <ThemeToggle />

      <!-- Primary Action CTA -->
      <a
        href={`${homeUrl}#waitlist`}
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 text-white shadow-sm shadow-emerald-600/20 transition-all hover:shadow-emerald-600/30 active:scale-95"
      >
        Early Access
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle Navigation Menu"
        class="md:hidden p-2 rounded-lg text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-4 border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 flex flex-col gap-2 text-sm font-medium text-zinc-700 dark:text-zinc-200">
    <div class="py-1">
      <a href={`${homeUrl}#features`} class="block py-1.5 hover:text-emerald-600 dark:hover:text-emerald-400">Features</a>
      <div class="pl-4 flex flex-col gap-1 border-l-2 border-zinc-100 dark:border-zinc-800 ml-1 mt-1 text-xs text-zinc-500 dark:text-zinc-400">
        <a href={`${homeUrl}#goals`} class="py-1 hover:text-emerald-600 dark:hover:text-emerald-400">Goal Planning</a>
        <a href={`${homeUrl}#deployments`} class="py-1 hover:text-emerald-600 dark:hover:text-emerald-400">Deployments</a>
      </div>
    </div>
    <a href={blogUrl} class="py-1.5 hover:text-emerald-600 dark:hover:text-emerald-400">Blog & Guides</a>
    <a href={`${homeUrl}#faq`} class="py-1.5 hover:text-emerald-600 dark:hover:text-emerald-400">FAQ</a>
    <div class="pt-2 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-end">
      <a href={`${homeUrl}#waitlist`} class="px-4 py-2 rounded-lg text-xs font-semibold bg-emerald-600 text-white">Join Waitlist</a>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }

  function setupWaitlistScroll() {
    document.querySelectorAll('a[href*="#waitlist"]').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        const target = document.getElementById('waitlist');
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          const input = target.querySelector('input[type="email"]') as HTMLInputElement | null;
          if (input) {
            setTimeout(() => input.focus({ preventScroll: true }), 400);
          }
        }
      });
    });
  }

  function setupHeader() {
    setupMobileMenu();
    setupWaitlistScroll();
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
