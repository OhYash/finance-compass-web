---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const featuredPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const getPostUrl = (id: string) => `${baseUrl}/blog/${id.replace(/\.(md|mdx)$/, '')}`;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-IN', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);
}
---

<BaseLayout
  title="paise fit — Cool, Welcoming Financial Fitness & Goal Planning"
  description="The cool, welcoming app to maintain your finances and plan ambitious life goals. Client-side statement parsing, anchor-aware ledger integrity, and flexible deployments: managed, on-premise, or self-hosted."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 sm:pt-20 pb-16 sm:pb-24 border-b border-zinc-200 dark:border-zinc-800">
    <!-- Subtle Background Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-emerald-500/10 dark:bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-6 relative z-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-100/70 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-300/50 dark:border-emerald-800/60 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Financial Fitness &middot; Built India-First</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 font-serif-editorial leading-[1.1] max-w-4xl mx-auto">
        Get your money into the <span class="underline decoration-emerald-500 decoration-4 underline-offset-8">best shape</span> of its life.
      </h1>

      <!-- Value Hook Subtitle -->
      <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        A cool, welcoming app to maintain your daily finances and plan ambitious life goals with zero stress. 100% private client-side statement parsing, rock-solid ledger math, and flexible deployments — managed, on-premise, or self-hosted.
      </p>

      <!-- Primary Waitlist Email Capture -->
      <div id="waitlist" class="pt-4 flex flex-col items-center">
        <WaitlistForm variant="hero" id="hero-waitlist" source="hero" />
      </div>

      <!-- Key Superpower Badges -->
