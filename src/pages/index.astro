---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const featuredPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const getPostUrl = (id: string) => `${baseUrl}/blog/${id.replace(/\.(md|mdx)$/, '')}`;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-IN', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);
}
---

<BaseLayout
  title="INR Finance Compass — Sovereign, Private Personal Finance OS for India"
  description="A sovereign personal finance OS engineered for Indian realities. Zero surveillance, zero data harvesting, anchor-aware ledger integrity, client-side statement parsing, and self-hosted on your own machine."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 sm:pt-20 pb-16 sm:pb-24 border-b border-zinc-200 dark:border-zinc-800">
    <!-- Subtle Background Glow -->
