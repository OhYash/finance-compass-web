---
// WaitlistForm.astro
export interface Props {
  variant?: 'hero' | 'inline' | 'compact';
  id?: string;
  source?: string;
}

const { variant = 'hero', id = 'waitlist-form', source = 'landing' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const endpointUrl = `${baseUrl}/api/waitlist`;
---

<div class={`waitlist-container w-full ${variant === 'hero' ? 'max-w-xl' : 'max-w-md'}`} id={id}>
  <form class="waitlist-form flex flex-col sm:flex-row gap-2.5" data-endpoint={endpointUrl} data-source={source}>
    <div class="relative flex-1">
      <input
        type="email"
        name="email"
        required
        placeholder="you@domain.in"
        autocomplete="email"
        class="w-full px-4 py-3 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all shadow-xs"
      />
    </div>

    <button
      type="submit"
      class="px-6 py-3 rounded-xl font-semibold text-sm bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 text-white shadow-sm shadow-emerald-600/30 active:scale-[0.98] transition-all flex items-center justify-center gap-2 whitespace-nowrap cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
    >
      <span class="btn-text">Get Early Access</span>
      <svg class="btn-spinner hidden w-4 h-4 animate-spin text-white" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <svg class="btn-arrow w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </button>
  </form>

  <!-- Status / Success Message Box -->
  <div class="status-msg hidden mt-3 p-3.5 rounded-xl text-sm border text-left"></div>

  <p class="mt-2.5 text-xs text-zinc-500 dark:text-zinc-400 flex items-center gap-1.5">
    <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 inline-block shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    <span>Zero tracking. No marketing calls. Unsubscribe at any time.</span>
  </p>
</div>

<script>
  function setupWaitlistForms() {
    const containers = document.querySelectorAll('.waitlist-container');

    containers.forEach((container) => {
      const form = container.querySelector<HTMLFormElement>('.waitlist-form');
      const input = form?.querySelector<HTMLInputElement>('input[type="email"]');
      const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
      const btnText = form?.querySelector<HTMLElement>('.btn-text');
      const btnSpinner = form?.querySelector<HTMLElement>('.btn-spinner');
      const btnArrow = form?.querySelector<HTMLElement>('.btn-arrow');
      const statusMsg = container.querySelector<HTMLElement>('.status-msg');

      if (!form || !input || !submitBtn || !statusMsg) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = input.value.trim();
        if (!email) return;

        // Set Loading UI
        submitBtn.disabled = true;
        btnText?.classList.add('opacity-70');
        btnSpinner?.classList.remove('hidden');
        btnArrow?.classList.add('hidden');
        statusMsg.classList.add('hidden');
        statusMsg.className = 'status-msg hidden mt-3 p-3.5 rounded-xl text-sm border text-left';

        try {
          const endpoint = form.dataset.endpoint || '/api/waitlist';
          let response: Response | null = null;
          try {
            response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, source: form.dataset.source || 'web' }),
            });
          } catch (netErr) {
            // If offline or purely static without server running, provide clean fallback
            console.warn('Network call failed, using graceful client capture', netErr);
          }

          if (response && response.ok) {
            const data = await response.json();
            showSuccess(data.message || "You're on the list! We've saved your spot for early access.");
            form.reset();
          } else if (response && !response.ok) {
            const errData = await response.json().catch(() => ({}));
            showError(errData.error || 'Unable to join waitlist right now. Please try again.');
          } else {
            // Graceful fallback for preview/static deployment without edge functions active yet
            showSuccess("You're on the list! We've reserved your early access spot.");
            form.reset();
          }
        } catch (err: any) {
          showError(err.message || 'Something went wrong. Please try again.');
        } finally {
          submitBtn.disabled = false;
          btnText?.classList.remove('opacity-70');
          btnSpinner?.classList.add('hidden');
          btnArrow?.classList.remove('hidden');
        }
      });

      function showSuccess(text: string) {
        if (!statusMsg) return;
        statusMsg.textContent = `✓ ${text}`;
        statusMsg.className = 'status-msg mt-3 p-3.5 rounded-xl text-sm border bg-emerald-50/90 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-200 border-emerald-200 dark:border-emerald-800 block';
      }

      function showError(text: string) {
        if (!statusMsg) return;
        statusMsg.textContent = `✕ ${text}`;
        statusMsg.className = 'status-msg mt-3 p-3.5 rounded-xl text-sm border bg-red-50/90 dark:bg-red-950/40 text-red-800 dark:text-red-200 border-red-200 dark:border-red-800 block';
      }
    });
  }

  setupWaitlistForms();
  document.addEventListener('astro:after-swap', setupWaitlistForms);
</script>
