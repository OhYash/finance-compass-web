---
// SeoHead.astro
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
  author?: string;
  tags?: string[];
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'paise fit — India-First Personal Finance & Wealth Tracker',
  description = 'The private, complete financial fitness app built for India. Unify your gold, real estate, stocks, mutual funds, EPF/PPF, and daily INR budgeting with zero ad tracking.',
  image = '/images/og-default.png',
  canonicalUrl,
  type = 'website',
  publishedTime,
  updatedTime,
  author = 'paise fit',
  tags = [],
  schema,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://paise.fit';
const currentUrl = canonicalUrl || new URL(Astro.url.pathname, Astro.site || 'https://paise.fit').href;
const formattedTitle = title.includes('paise fit') ? title : `${title} | paise fit`;
const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
const rssUrl = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/rss.xml`, Astro.site || 'https://paise.fit').href;

// Default structured data: Organization and WebSite
const defaultSchemas: Array<Record<string, any>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'paise fit',
    url: siteUrl,
    logo: `${siteUrl}/favicon.svg`,
    description: 'India-First Personal Finance & Sovereign Wealth Tracker.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: siteUrl,
    name: 'paise fit',
    publisher: {
      '@id': `${siteUrl}/#organization`,
    },
  },
];

if (type === 'article') {
  defaultSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': currentUrl,
    },
    headline: title,
    description: description,
    image: ogImageUrl,
    author: {
      '@type': 'Person',
      name: author,
    },
    publisher: {
      '@id': `${siteUrl}/#organization`,
    },
    datePublished: publishedTime,
    ...(updatedTime ? { dateModified: updatedTime } : (publishedTime ? { dateModified: publishedTime } : {})),
    ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
  });
}

// Allow page-specific schemas to override or augment
const computedSchemas = schema
  ? (Array.isArray(schema) ? schema : [schema])
  : defaultSchemas;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta Tags -->
  <title>{formattedTitle}</title>
  <meta name="title" content={formattedTitle} />
  <meta name="description" content={description} />
  <meta name="author" content={author} />
  {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}

  <!-- Canonical URL -->
  <link rel="canonical" href={currentUrl} />

  <!-- RSS Feed Auto-Discovery -->
  <link rel="alternate" type="application/rss+xml" title="paise fit Blog" href={rssUrl} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={formattedTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {updatedTime && <meta property="article:modified_time" content={updatedTime} />}

  <!-- Twitter / X -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={currentUrl} />
  <meta property="twitter:title" content={formattedTitle} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImageUrl} />

  <!-- Structured Data / JSON-LD -->
  {computedSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <!-- Theme Color and Script to prevent FOUC -->
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#059669" />

  <script is:inline>
    // Inline script immediately executed to prevent flash of wrong theme
    (function() {
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>
</head>
